# ---- App ----
APP_NAME=AI Index Generator
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# ---- Storage ----
# MAX_UPLOAD_BYTES=52428800   # 50 MB

# ---- Database ----
# Local default is SQLite. For Postgres (e.g. Neon):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./index_generator.db

# ---- Auth ----
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- LLM provider: openai | gemini | ollama | fallback ----
# "fallback" needs no API key and uses a built-in heuristic extractor.
LLM_PROVIDER=fallback
LLM_MODEL=
LLM_TEMPERATURE=0.0
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Chunking ----
CHUNK_SIZE=4000
CHUNK_OVERLAP=200

# ---- Vector store (optional) ----
ENABLE_VECTOR_STORE=false

# ---- Rate limiting ----
RATE_LIMIT=60/minute
